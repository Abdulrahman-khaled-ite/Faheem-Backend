						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/ingestion/candidates/?status=VERIFIED",
							"host": ["{{base_url}}"],
							"path": ["ingestion", "candidates", ""],
							"query": [
								{"key": "status", "value": "VERIFIED", "description": "CANDIDATE / VERIFIED / AMBIGUOUS / REJECTED"}
							]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "4. واجهة بوت تليغرام (Telegram Bot API)",
			"item": [
				{
					"name": "استقبال الـ Webhook الرسمي (Webhook Endpoint)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "X-Telegram-Bot-Api-Secret-Token", "value": "faheem_secret_webhook_key_2026", "description": "رمز الحماية السري"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"update_id\": 10001,\n    \"message\": {\n        \"message_id\": 50,\n        \"from\": {\n            \"id\": 123456789,\n            \"is_bot\": false,\n            \"first_name\": \"أحمد\",\n            \"username\": \"ahmad_student\"\n        },\n        \"chat\": {\n            \"id\": 123456789,\n            \"type\": \"private\"\n        },\n        \"date\": 1732000000,\n        \"text\": \"/start\"\n    }\n}"
						},
						"url": {
							"raw": "{{base_url}}/telegram/webhook/",
							"host": ["{{base_url}}"],
							"path": ["telegram", "webhook", ""]
						}
					},
