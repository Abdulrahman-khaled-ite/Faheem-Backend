{
	"info": {
		"_postman_id": "faheem-backend-api-v2",
		"name": "Faheem (فهيم) - Backend API Collection",
		"description": "مجموعة طلبات Postman الرسمية والشاملة لكافة واجهات REST API الخاصة بمنصة 'فهيم' (Faheem) - كلية الهندسة المعلوماتية، جامعة دمشق.\n\nتعتمد المجموعة على متغير بيئة مركزي `{{base_url}}` بحيث يمكن تغيير خادم الاستضافة (محلي / سحابي) بنقرة زر واحدة.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api/v1",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. النواة الأكاديمية والعلامات (Academic Core)",
			"item": [
				{
					"name": "استعراض السجلات الأكاديمية (Academic Records)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/academic/records/?search=",
							"host": ["{{base_url}}"],
							"path": ["academic", "records", ""],
							"query": [
								{"key": "search", "value": "", "description": "بحث بالاسم أو الرقم الجامعي"}
							]
						},
						"description": "جلب قائمة السجلات الأكاديمية للطلاب مع إمكانية البحث."
					},
					"response": []
				},
				{
					"name": "إنشاء سجل أكاديمي جديد (Create Record)",
					"request": {
						"method": "POST",
						"header": [
							{"key": "Content-Type", "value": "application/json"},
							{"key": "Accept", "value": "application/json"}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"official_name\": \"محمد أحمد العلي\",\n    \"normalized_name\": \"محمد احمد العلي\",\n    \"university_id\": \"ite_2024_0145\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/academic/records/",
							"host": ["{{base_url}}"],
							"path": ["academic", "records", ""]
						}
					},
					"response": []
				},
				{
					"name": "جلب علامات طالب محدد (Student Grades)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/academic/records/1/grades/",
							"host": ["{{base_url}}"],
							"path": ["academic", "records", "1", "grades", ""]
						},
						"description": "عرض كافة العلامات المنشورة رسمياً لطالب محدد بمعرفه الداخلي."
					},
					"response": []
				},
				{
					"name": "استعراض المقررات الدراسية (Courses)",
					"request": {
						"method": "GET",
						"header": [
							{"key": "Accept", "value": "application/json"}
						],
						"url": {
							"raw": "{{base_url}}/academic/courses/?original_study_year=1&department=عام&semester=1",
							"host": ["{{base_url}}"],
							"path": ["academic", "courses", ""],
							"query": [
								{"key": "original_study_year", "value": "1", "description": "السنة الدراسية (1-5)"},
								{"key": "department", "value": "عام", "description": "الاختصاص (عام / برمجيات / ذكاء / شبكات)"},
								{"key": "semester", "value": "1", "description": "الفصل الدراسي (1 أو 2)"}
							]
						}
					},
					"response": []
				},
				{
					"name": "استعراض السنوات الأكاديمية (Academic Years)",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/academic/years/",
							"host": ["{{base_url}}"],
							"path": ["academic", "years", ""]
						}
					},
					"response": []
				},
				{
					"name": "استعراض نطاقات النشر (Publication Scopes)",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/academic/scopes/?state=PUBLISHED",
							"host": ["{{base_url}}"],
							"path": ["academic", "scopes", ""],
							"query": [
								{"key": "state", "value": "PUBLISHED", "description": "حالة النشر (PENDING / PUBLISHED / STALE)"}
							]
						}
					},
					"response": []
				},
				{
					"name": "استعراض العلامات الحالية المنشورة (Current Grades)",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/academic/grades/",
							"host": ["{{base_url}}"],
							"path": ["academic", "grades", ""]
						}
					},
					"response": []
				}
			]
		},
		{
