				{
					"name": "استعراض مهام المعالجة (Processing Jobs)",
					"request": {
						"method": "GET",
						"header": [{"key": "Accept", "value": "application/json"}],
						"url": {
							"raw": "{{base_url}}/ingestion/jobs/?state=COMPLETED",
							"host": ["{{base_url}}"],
							"path": ["ingestion", "jobs", ""],
							"query": [
								{"key": "state", "value": "COMPLETED", "description": "PENDING / PROCESSING / COMPLETED / FAILED"}
							]
						}
					},
					"response": []
				},
				{
					"name": "استعراض مرشحي المطابقة لمهمة محددة (Job Candidates)",
